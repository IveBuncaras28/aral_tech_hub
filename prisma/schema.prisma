// AralTech Hub — Prisma schema (v3)
// Hierarchy: Subject -> GradeLevel -> Term -> Topic -> Lesson -> Quiz -> Question
//
// v3 adds: NextAuth (Google login) models, User.role for admin access,
// and cascade deletes so admin content editing/deletion works cleanly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CurriculumFramework {
  MATATAG
  MELC
  SHS_STRENGTHENED
  SHS_LEGACY
}

enum ShsTrack {
  ACADEMIC
  TECHPRO
}

enum Role {
  STUDENT
  ADMIN
}

model Subject {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  gradeLevels GradeLevel[]
  createdAt   DateTime     @default(now())
}

model GradeLevel {
  id          Int                 @id @default(autoincrement())
  subject     Subject             @relation(fields: [subjectId], references: [id])
  subjectId   String
  gradeNumber Int
  framework   CurriculumFramework
  shsTrack    ShsTrack?
  terms       Term[]

  @@unique([subjectId, gradeNumber])
}

model Term {
  id           String     @id @default(cuid())
  gradeLevel   GradeLevel @relation(fields: [gradeLevelId], references: [id])
  gradeLevelId Int
  termNumber   Int
  topics       Topic[]

  @@unique([gradeLevelId, termNumber])
}

model Topic {
  id             String   @id @default(cuid())
  term           Term     @relation(fields: [termId], references: [id])
  termId         String
  title          String
  slug           String
  competencyCode String?
  order          Int      @default(0)
  lessons        Lesson[]

  @@unique([termId, slug])
}

model Lesson {
  id         String     @id @default(cuid())
  topic      Topic      @relation(fields: [topicId], references: [id])
  topicId    String
  title      String
  slug       String
  contentMdx String     @db.Text
  order      Int        @default(0)
  quiz       Quiz?
  progress   Progress[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([topicId, slug])
}

model Quiz {
  id        String        @id @default(cuid())
  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId  String        @unique
  title     String
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id            String   @id @default(cuid())
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId        String
  prompt        String   @db.Text
  choices       Json
  correctAnswer String
  explanation   String?  @db.Text
  order         Int      @default(0)
}

// --- Auth (NextAuth.js, Google login) ---

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  role          Role          @default(STUDENT)
  accounts      Account[]
  sessions      Session[]
  progress      Progress[]
  quizAttempts  QuizAttempt[]
  createdAt     DateTime      @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Progress tracking ---

model Progress {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId      String
  score       Int
  totalItems  Int
  attemptedAt DateTime @default(now())
}
